# Banco Neon
# DATABASE_URL tem prioridade quando preenchida.
DATABASE_URL=
PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
PG_SSLMODE=require

# Espelho PostgreSQL local. Usado pelo sync_agent.py.
DB_HOST=localhost
DB_PORT=5432
DB_DB=VoJoaquina
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer
SYNC_POLL_SECONDS=5
SYNC_BATCH_SIZE=500

# Usado somente se ainda nao existir nenhum usuario compartilhado.
ACCESS_USERNAME=admin
ACCESS_PASSWORD=

# Aplicacao local
APP_NAME=CVJAPP
APP_ENV=production
SESSION_MAX_MINUTES=480
SESSION_RECHECK_SECONDS=30

# Pasta onde os PDFs serao salvos
PDF_DIR=
